# ==============================================================================
# UNIDAD: CACHÉ, ARCHIVOS TEMPORALES Y GENERADOS AUTOMÁTICAMENTE
# ==============================================================================
# Estas carpetas son generadas por Unity en runtime y pueden ser recreadas.
# Nunca deben subirse al repositorio por su gran tamaño.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]ser[Ss]ettings/

# Archivos autogenerados y de bloqueo
*.apk
*.aab
*.unitypackage
*.app
sysinfo.txt
*.crash
crash_info.txt

# ==============================================================================
# EDITORES E IDEs
# ==============================================================================
# Archivos autogenerados por Visual Studio, VS Code, Rider y MonoDevelop
# Visual Studio
.vs/
*.sln
*.csproj
*.userprefs
*.suo
*.user

# Visual Studio Code
.vscode/

# JetBrains Rider / IntelliJ
.idea/
*.sln.DotSettings.user
*.sln.DotSettings

# ==============================================================================
# ARCHIVOS DEL SISTEMA OPERATIVO
# ==============================================================================
# Basura del sistema que no pertenece al proyecto
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==============================================================================
# EXCEPCIONES IMPORTANTES (PROTEGER LO ESENCIAL)
# ==============================================================================
# Asegurarnos de que las carpetas vitales NUNCA se ignoren por accidente
!/[Aa]ssets/
!/[Pp]roject[Ss]ettings/
!/[Pp]ackages/

# Ignorar videos pesados específicos
Assets/creditos finales.mov