  lines:
  - speaker: 1
    emotion: 1
    text: "Llegamos a salvo en la furgoneta, Andrius! El bosque esta bajo grave amenaza ambiental. Que necesitas saber?"
    choices:
    - optionText: "Consejos del Bosque"
      fullResponseText: ""
      actionType: 0
      customEventKey: ""
      nextDialogueBlock: {fileID: 11400000, guid: d4e5f6a1b2c34d5e6f7a8b9c0d1e2f3a, type: 2}
    - optionText: "Rumores y Lore"
      fullResponseText: ""
      actionType: 0
      customEventKey: ""
      nextDialogueBlock: {fileID: 11400000, guid: a1b2c3d4e5f67a8b9c0d1e2f3a4b5c6d, type: 2}
    - optionText: "Listo, a luchar!"
      fullResponseText: "Buena suerte, Andrius! Mantente cerca de las grietas para restaurar el suelo y recuperar vida. La naturaleza cuenta contigo!"
      actionType: 0
      customEventKey: ""
      nextDialogueBlock: {fileID: 0}
